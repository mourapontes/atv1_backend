# Porta em que a API vai rodar
PORT=3555

# Ambiente
NODE_ENV=development

# String de conexão PostgreSQL (obrigatória).
# Exemplo (usando o docker-compose.yml deste projeto): postgres://postgres:postgres@localhost:5432/devshowcase
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devshowcase

# Opcional: exigir SSL na conexão com o banco (útil em provedores como Render/Heroku)
# DB_SSL=false
